{
  "name": "askwire",
  "version": "0.1.0",
  "description": "Does your MCP server's elicitation reach a human? Runs the AI clients installed on your machine (Claude Code, Codex, opencode) against a probe server and shows what each one really answers.",
  "type": "module",
  "bin": {
    "askwire": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepare": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elicitation",
    "claude-code",
    "codex",
    "opencode",
    "ai-agents",
    "testing",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackman99/askwire.git"
  },
  "homepage": "https://blackman99.github.io/askwire/",
  "bugs": {
    "url": "https://github.com/Blackman99/askwire/issues"
  },
  "license": "MIT",
  "author": "Blackman99",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0"
  }
}
